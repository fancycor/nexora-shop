# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Persistence Configuration (Optional)
# If provided, customer Cash on Delivery orders will be saved persistently in your Supabase database.
# Free setup at https://supabase.com
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Dashboard Password (Defaults to nexora2026 if not set)
ADMIN_PASSWORD="nexora2026"

